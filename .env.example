# Copy to .env for local development. Never commit .env.

PORT=3000

# pglite://.data/pglite  -> local embedded Postgres (no install needed)
# postgres://...          -> real Postgres, e.g. Neon in production
DATABASE_URL=pglite://.data/pglite

# dev   -> trusts the x-clientdesk-user header (or DEV_USER). Local testing only; refused in production.
# oauth -> real sign-in (arrives on Day 3)
AUTH_MODE=dev
DEV_USER=maya@northbridge.example

# Host names the HTTP server answers to. Add your ngrok host when testing as a Claude connector.
# ALLOWED_HOSTS=localhost,127.0.0.1,your-subdomain.ngrok-free.app

# Load the fictional Northbridge Advisory firm on first start.
SEED_DEMO=1
