# Copy to .env for local development. Never commit .env.
# Everything below works as-is for local use: no accounts or keys needed.

PORT=3000

# pglite://.data/pglite  -> local embedded Postgres (no install needed)
# postgres://...          -> real Postgres, e.g. Neon in production
DATABASE_URL=pglite://.data/pglite

# Load the fictional Northbridge Advisory firm and its documents on first start.
SEED_DEMO=1

# ---------------------------------------------------------------------------
# Sign-in
# ---------------------------------------------------------------------------
# dev   -> trusts the x-clientdesk-user header (or DEV_USER). Local testing only; refused in production.
# oauth -> real sign-in through WorkOS AuthKit (or Auth0). Needs PUBLIC_URL and OAUTH_ISSUER.
AUTH_MODE=dev
DEV_USER=maya@northbridge.example

# This server's public https address (your ngrok or Render URL), without /mcp.
# PUBLIC_URL=https://your-subdomain.ngrok-free.app

# Your AuthKit domain (WorkOS) or Auth0 tenant URL.
# OAUTH_ISSUER=https://your-subdomain.authkit.app

# Optional. Defaults: JWKS from the issuer's discovery document; audience = PUBLIC_URL + /mcp;
# email from the "email" claim (Auth0 needs a namespaced claim, e.g. https://clientdesk/email).
# OAUTH_JWKS_URL=
# OAUTH_AUDIENCE=
# OAUTH_EMAIL_CLAIM=email

# Only for `npm run workos:users` (creates the demo staff in WorkOS). The server never reads it.
# Use the Staging environment's secret key (sk_test_...).
# WORKOS_API_KEY=

# Optional: a regular OAuth app for the dashboard's own sign-in (redirect: PUBLIC_URL/auth/callback).
# DASHBOARD_CLIENT_ID=
# DASHBOARD_CLIENT_SECRET=

# "Try the demo" button on the dashboard sign-in page: a read-only, partner-level session as the fictional demo
# visitor, no account needed. Every write is refused on the server and audited. Off unless set to true.
DEMO_LOGIN=false
# Reverse proxies in front of the server (Render: 1). Lets the demo sign-in rate limit see the visitor's IP.
# TRUST_PROXY=0

# Signing keys for dashboard sessions and document links. Required in production (32+ random characters):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Left empty locally, a random one is used per run (links and sessions reset on restart).
# SESSION_SECRET=
# LINK_SECRET=

# Host names the HTTP server answers to. Defaults to PUBLIC_URL's host + localhost.
# ALLOWED_HOSTS=localhost,127.0.0.1,your-subdomain.ngrok-free.app

# Extra browser origins allowed to call /mcp and /api. PUBLIC_URL's origin is always allowed.
# ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# AI (leave the keys empty for free offline mode)
# ---------------------------------------------------------------------------
# auto -> Claude if ANTHROPIC_API_KEY is set, else Groq if GROQ_API_KEY is set, else the offline rules extractor.
# Or force one: claude | groq | rules.
EXTRACTOR=auto
# Set a spend limit in the Anthropic console before adding this.
# ANTHROPIC_API_KEY=
# Groq (console.groq.com): free tier, open models (gpt-oss), text only, so scanned documents go to review.
# GROQ_API_KEY=

# auto -> Voyage when VOYAGE_API_KEY is set, otherwise local hashing embeddings.
# After switching, run `npm run seed -- --reset` so documents are re-embedded with the new model.
EMBEDDINGS=auto
# VOYAGE_API_KEY=

# ---------------------------------------------------------------------------
# File storage
# ---------------------------------------------------------------------------
# local -> files under FILES_DIR. s3 -> Amazon S3 (use in production: hosting disks are wiped on deploy).
# r2 -> Cloudflare R2. Check keys from your laptop with: STORAGE=s3 npm run storage:check
STORAGE=local
FILES_DIR=.data/files
# S3_BUCKET=clientdesk-documents-yourname
# S3_REGION=us-west-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Only for S3-compatible services other than AWS (Backblaze B2, Supabase, MinIO):
# S3_ENDPOINT=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=clientdesk-documents

# ---------------------------------------------------------------------------
# Filing rule
# ---------------------------------------------------------------------------
# A document is filed automatically only when the best client scores at least FILE_THRESHOLD
# and beats the runner-up by FILE_MARGIN. Everything else goes to the review queue.
FILE_THRESHOLD=0.85
FILE_MARGIN=0.15
